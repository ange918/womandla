# Supabase — sans ces trois variables, candidatures, dons, contact et newsletter
# restent désactivés côté serveur (le formulaire fonctionne, rien n’est persisté).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mobile Money local. Une seule des deux intégrations suffit.
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=

# Cartes internationales. Le PaymentIntent n’est pas créé tant que ces clés manquent.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Reçu de don et notifications. Absent = aucun e-mail n’est envoyé.
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=contact@womandla.bj

# Optionnel, non branché : notification de changement de statut.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
